# Copy to .env and fill in. Never commit .env.
# Names match what the code currently reads (including the legacy spelling of
# cloudflare_accesss_key); they will be normalized in a later phase.

# Supabase Postgres (use the Transaction pooler connection string)
postgres_url=
# Optional overrides. DATABASE_URL wins over postgres_url for the app;
# MIGRATION_DATABASE_URL wins for Alembic (use the DIRECT, non-pooled connection).
# If the direct host fails with "could not translate host name" (it is IPv6-only, and some networks lack IPv6),
# use the SESSION-mode pooler instead: the same address as postgres_url but port 5432 instead of 6543.
# Do not use port 6543 (transaction mode) for migrations.
# Local docker db: postgresql+psycopg2://postgres:postgres@localhost:5433/photos
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Supabase Auth (see README, "Sign-in setup")
SUPABASE_URL=
# PUBLIC key (Dashboard > Project Settings > API Keys > publishable / anon). Safe to expose to browsers.
# NEVER put the service_role / secret key here or anywhere in this project.
SUPABASE_ANON_KEY=
# 'dev' enables dangerous admin routes (wipe-data). Leave unset in production.
APP_ENV=
APP_BASE_URL=http://localhost:8000

# Cloudflare R2 (S3-compatible)
cloudflare_endpoint=
cloudflare_access_id=
cloudflare_accesss_key=
cloudflare_token=
R2_BUCKET_NAME=
# Slated for removal in Phase 3 (bucket becomes private)
R2_PUBLIC_URL=

# Hugging Face
hugging_face_token=

# Background worker (python -m app.worker)
# WORKER_POLL_SECONDS=2
